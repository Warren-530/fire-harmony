# Fire Harmony house style for matplotlib (see fireharmony_style.py for tokens)
font.family: Inter
font.size: 9
axes.titlesize: 12.5
axes.titleweight: semibold
axes.titlelocation: left
axes.labelsize: 9
axes.labelcolor: 52514e
axes.edgecolor: c3c2b7
axes.linewidth: 0.8
axes.facecolor: fcfcfb
axes.spines.top: False
axes.spines.right: False
axes.grid: True
axes.grid.axis: y
axes.axisbelow: True
axes.prop_cycle: cycler('color', ['2a78d6', 'eb6834', '1baf7a', 'eda100', 'e87ba4', '008300', '6250d6', 'e34948'])
grid.color: e1e0d9
grid.linewidth: 0.6
grid.linestyle: -
xtick.color: 898781
ytick.color: 898781
xtick.labelsize: 8
ytick.labelsize: 8
xtick.major.size: 0
ytick.major.size: 0
lines.linewidth: 2
lines.solid_capstyle: round
lines.markersize: 6
patch.linewidth: 0
legend.frameon: False
legend.fontsize: 8
legend.labelcolor: 52514e
figure.facecolor: fcfcfb
figure.dpi: 120
figure.constrained_layout.use: True
savefig.facecolor: fcfcfb
savefig.bbox: tight
savefig.pad_inches: 0.12
text.color: 0b0b0b
image.cmap: ember
pdf.fonttype: 42
svg.fonttype: none
